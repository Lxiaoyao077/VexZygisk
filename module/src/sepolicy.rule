type zygisk_file file_type
typeattribute zygisk_file mlstrustedobject
allow zygote zygisk_file sock_file {read write}

# INFO: "map" and "execute" are needed on top of "read open" because the loader
#       mmaps and dlopens module libraries that reach it as unlabeled memfds on
#       kernels without the tmpfs labelling.
allow zygote unlabeled file {getattr read open map execute}
allow zygote zygote capability sys_chroot

# INFO: To allow to setns on the Zygote's child mns. KernelSU renamed the su context to ksu
allow zygote ksu dir search
allow zygote ksu {lnk_file file} read

allow zygote adb_data_file dir search
allow zygote adb_data_file file *
allow zygote proc file {read open}
allow zygote nsfs file {read open}
allow zygote zygote process execmem
allow system_server system_server process execmem
allow zygote tmpfs file *
allow zygote appdomain_tmpfs file *

# INFO: Needed for Tango Zygote
allow zygote system_lib_file file execmod

# INFO: Zygisk Next libraries travel as memfds created by this daemon, so they
#       carry the daemon's own domain label, which under KernelSU is "ksu".
#       dlopen needs "execute" on them from whichever process loads the module.
#
#       This stays on the memfd's type on purpose: "allow * * file execute"
#       also grants untrusted_app execute on dex2oat_exec, which is a sandbox
#       hole in its own right and is exactly what makes LSPosed/Vector report
#       its dex2oat wrapper as unsupported ("SELinux not properly configured").
allow * ksu file execute

# INFO: How a memfd is labelled depends on the kernel:
#
#         - GKI kernels: an anonymous inode of the tmpfs superblock, class
#           "file", type "tmpfs". Covered for zygote by "allow zygote tmpfs
#           file *" above, but the daemon-spawned ZN companion loads the very
#           same memfds and had no rule at all.
#
#         - Other kernels: the memfd shows up as "unlabeled". Zygote only had
#           "read open" here, which lets it receive the descriptor and still
#           fail the mmap that dlopen performs, and the companion had nothing
#           at all.
#
#         - Newer kernels (Android 17 QPR1 onwards): memfds are labelled
#           through security_inode_init_security_anon(), carrying the creating
#           task's own SID under the new "memfd_file" class. Neither a tmpfs
#           nor a file rule matches that, so every SCM_RIGHTS transfer of a
#           memfd is silently dropped and no module library can be handed over.
#
#       Without these, the loader receives nothing for ReadZnModules and the
#       ZN companion cannot dlopen its library: the ZN module never loads,
#       while descriptor-free actions such as GetProcessFlags keep working,
#       which makes the failure look like a matching problem.
allow zygote ksu memfd_file {getattr read write map execute}

allow ksu ksu memfd_file {getattr read write map execute}
allow ksu tmpfs file {getattr read write map execute}
allow ksu unlabeled file {getattr read write map execute}
